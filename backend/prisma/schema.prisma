generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  password        String
  name            String
  role            UserRole     @default(STAFF)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  uploadedFiles   File[]
  sentInvitations Invitation[]
  createdInvoices Invoice[]
  createdJobs     Job[]        @relation("CreatedJobs")
  updatedJobs     Job[]        @relation("UpdatedJobs")
  assignedJobs    Job[]        @relation("AssignedJobs")
  statusHistory   JobStatusHistory[] @relation("StatusHistory")
  createdPayments Payment[]

  @@map("users")
}

model Customer {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique
  phone              String
  address            String
  city               String?
  country            String         @default("Ghana")
  customerType       CustomerType   @default(COMPANY)
  status             CustomerStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  contactPerson      String?
  ghanaCard          String?
  tin                String?
  consignments       Consignment[]
  enquiries          Enquiry[]
  invoices           Invoice[]
  jobs               Job[]

  @@map("customers")
}

model Consignment {
  id               String            @id @default(cuid())
  trackingId       String            @unique
  customerId       String
  consigneeName    String
  consigneePhone   String
  consigneeAddress String
  ghanaCard        String?
  tin              String?
  status           ConsignmentStatus @default(PENDING)
  date             DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs             Job[]

  @@map("consignments")
}

model Job {
  id             String             @id @default(cuid())
  trackingId     String             @unique
  customerId     String
  consignmentId  String?
  createdById    String
  updatedById    String?
  assignedToId   String
  assignedTo     User             @relation("AssignedJobs", fields: [assignedToId], references: [id])
  status         JobStatus          @default(NEW)
  submittedDate  DateTime           @default(now())
  eta            DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  goodsTypes     String[]           @default([])
  mediumOfEnquiry String?
  documentsBrought String[]         @default([])
  containerNumber String?
  blNumber       String?
  vesselName     String?
  line           String?
  jobDescription String?
  invoices       Invoice[]
  documents      JobDocument[]
  statusHistory  JobStatusHistory[]
  consignment    Consignment?       @relation(fields: [consignmentId], references: [id])
  createdBy      User               @relation("CreatedJobs", fields: [createdById], references: [id])
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  updatedBy      User?              @relation("UpdatedJobs", fields: [updatedById], references: [id])

  @@map("jobs")
}

model JobStatusHistory {
  id            String    @id @default(cuid())
  jobId         String
  status        JobStatus
  comment       String?
  updatedById   String
  updatedByUser User      @relation("StatusHistory", fields: [updatedById], references: [id])
  date          DateTime  @default(now())
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_status_history")
}

model JobDocument {
  id         String   @id @default(cuid())
  jobId      String
  filename   String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_documents")
}

model Enquiry {
  id                String        @id @default(cuid())
  customerId        String
  commercialInvoice String?
  port              String
  ghanaCard         String?
  tin               String?
  status            EnquiryStatus @default(SUBMITTED)
  submittedDate     DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("enquiries")
}

model Shipment {
  id                 String              @id @default(cuid())
  trackingId         String              @unique
  customerName       String
  customerEmail      String
  customerPhone      String
  customerAddress    String
  packageType        String
  packageWeight      Float
  packageValue       Float
  packageDescription String
  collectionAddress  String
  deliveryAddress    String
  deliveryCity       String
  recipientName      String
  recipientPhone     String
  serviceType        ShipmentServiceType
  status             ShipmentStatus      @default(BOOKED)
  collectionDate     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invoices           Invoice[]

  @@map("shipments")
}

model Invoice {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  jobId         String
  shipmentId    String?
  customerId    String
  createdById   String
  amount        Float
  status        InvoiceStatus  @default(PENDING)
  issueDate     DateTime
  dueDate       DateTime
  paymentDate   DateTime?
  paymentMethod PaymentMethod?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     User           @relation(fields: [createdById], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job           Job            @relation(fields: [jobId], references: [id])
  shipment      Shipment?      @relation(fields: [shipmentId], references: [id])
  payments      Payment[]

  @@map("invoices")
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String?
  gatewayRef    String?       @unique
  amount        Float
  currency      String        @default("GHS")
  payer         String
  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)
  receiptUrl    String?
  date          DateTime      @default(now())
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     User          @relation(fields: [createdById], references: [id])
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Invitation {
  id            String           @id @default(cuid())
  email         String           @unique
  role          UserRole
  invitedBy     String
  status        InvitationStatus @default(PENDING)
  invitedAt     DateTime         @default(now())
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  invitedByUser User             @relation(fields: [invitedBy], references: [id])

  @@map("invitations")
}

model File {
  id             String   @id @default(cuid())
  originalName   String
  filename       String
  path           String
  url            String
  mimeType       String
  size           Int
  folder         String   @default("general")
  category       String?
  entityId       String?
  entityType     String?
  uploadedBy     String
  uploadedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  uploadedByUser User     @relation(fields: [uploadedBy], references: [id])

  @@map("files")
}

enum UserRole {
  ADMIN
  STAFF
  DRIVER
  WAREHOUSE
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ConsignmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
}

enum JobStatus {
  NEW
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  AWAITING_PAYMENT
  PAID
  CLEARING
  CLEARED
  READY_FOR_SHIPMENT
  IN_TRANSIT
  ARRIVED_AT_PORT
  OUT_FOR_DELIVERY
  DELIVERED
  CLOSED
  ON_HOLD
  REJECTED
}

enum EnquiryStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  CLOSED
}

enum ShipmentServiceType {
  STANDARD
  EXPRESS
  PREMIUM
}

enum ShipmentStatus {
  BOOKED
  COLLECTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}
