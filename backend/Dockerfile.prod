FROM node:18-bullseye

WORKDIR /app

# Copy dependency files first (Docker layer caching)
COPY package*.json ./
COPY prisma ./prisma/

# Install production dependencies only
RUN npm ci --omit=dev

# Copy application code
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Expose application port
EXPOSE 5000

# Start application
CMD ["npm","start"]


