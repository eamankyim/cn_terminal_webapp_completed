# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (will be overridden by docker-compose)
DATABASE_URL=postgresql://cn_terminal_user:changeme@postgres:5432/cn_terminal_db?schema=public

# JWT Configuration
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-generated-jwt-secret-here
JWT_EXPIRES_IN=24h

# CORS Configuration
# Your production domain(s) - comma-separated list
# Example: CORS_ORIGIN=http://81.0.247.14:3000,https://your-domain.com
CORS_ORIGIN=

# Frontend URL (for Socket.IO)
# Example: FRONTEND_URL=http://81.0.247.14:3000
FRONTEND_URL=

# Production URL (for Swagger/API docs)
# Example: PRODUCTION_URL=http://81.0.247.14:5000
PRODUCTION_URL=

# Application Base URL (for generating invitation links)
# This is used for generating invitation links in emails
# Example: APP_BASE_URL=http://81.0.247.14:3000 or https://your-domain.com
APP_BASE_URL=

