# Root .env file for Docker Compose
# Copy this to .env and update with your production values

# Database Password (for PostgreSQL container)
DB_PASSWORD=changeme_secure_password_here

# JWT Secrets
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-generated-jwt-secret-here

# Backend API URL (for frontend to call backend)
# Example: REACT_APP_API_URL=https://app.cnterminalghana.com/api
REACT_APP_API_URL=

# Frontend URL (for Socket.IO)
# Example: FRONTEND_URL=https://app.cnterminalghana.com
FRONTEND_URL=

# Production URL (for Swagger/API docs)
# Example: PRODUCTION_URL=https://app.cnterminalghana.com
PRODUCTION_URL=

# CORS Origin (comma-separated list of allowed origins)
# Example: CORS_ORIGIN=https://app.cnterminalghana.com
CORS_ORIGIN=

# Application Base URL (for generating invitation links)
# Example: APP_BASE_URL=https://app.cnterminalghana.com
APP_BASE_URL=

# MNotify SMS (backend)
# MNOTIFY_API_KEY=
# MNOTIFY_SENDER_ID=CNTerminal
# SMS_DEV_MODE=true

 