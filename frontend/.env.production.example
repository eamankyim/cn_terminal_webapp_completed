# Application Info
REACT_APP_NAME=CN Terminal
REACT_APP_LOGO_PATH=/AppLogo.png

# Backend API Configuration
# Update this to your production API URL
REACT_APP_API_URL=http://localhost:5000/api
# REACT_APP_API_URL=http://81.0.247.14:5000/api
# REACT_APP_API_URL=https://api.your-domain.com/api

# Support Contact
REACT_APP_SUPPORT_EMAIL=support@cnterminal.com
REACT_APP_SUPPORT_PHONE=+233 XX XXX XXXX

# LocalStorage Keys
REACT_APP_USER_STORAGE_KEY=cn_terminal_user
REACT_APP_TOKEN_STORAGE_KEY=cn_terminal_token

# Feature Flags
REACT_APP_ENABLE_TRACKING=false
REACT_APP_ENABLE_NOTIFICATIONS=true


