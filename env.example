# ============================================
# CN Terminal - Environment Variables Example
# ============================================
# Copy this file to .env (for development) or .env.production (for production)
# Fill in your actual values
# ============================================

# Node Environment
NODE_ENV=production

# Database Configuration
DATABASE_URL=postgresql://cn_terminal_user:your_password@localhost:5432/cn_terminal_db?schema=public

# Server Configuration
PORT=5000

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Frontend/Backend URLs
FRONTEND_URL=http://localhost:3000
PRODUCTION_URL=http://localhost:5000
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Email Configuration (SendGrid)
REACT_APP_SENDGRID_API_KEY=your_sendgrid_api_key_here
REACT_APP_FROM_EMAIL=noreply@sendgrid.net
REACT_APP_FROM_NAME=CN Terminal
REACT_APP_EMAIL_DEV_MODE=false

# Frontend Build Configuration
REACT_APP_API_URL=http://localhost:5000/api

# Docker Configuration
DB_PASSWORD=your_db_password_here

