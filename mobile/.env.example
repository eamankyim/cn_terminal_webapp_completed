# CN Terminal Mobile – environment variables
# Expo uses EXPO_PUBLIC_* at build/run time. Do not commit secrets.

# Backend API base URL (must include /api)
EXPO_PUBLIC_API_URL=https://app.cnterminalghana.com/api
# Local backend (use machine LAN IP, not localhost, for physical devices):
# EXPO_PUBLIC_API_URL=http://192.168.0.127:5003/api

# Optional: credentials for npm run test:api
# MOBILE_TEST_EMAIL=
# MOBILE_TEST_PASSWORD=
