# ============================================
# CN Terminal - Production Environment Variables Template
# ============================================
# Copy this file to .env.production and fill in your actual production values
# DO NOT commit .env.production to version control
# ============================================

# ============================================
# Node Environment
# ============================================
NODE_ENV=production

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://cn_terminal_user:your_secure_password@localhost:5432/cn_terminal_db?schema=public
DATABASE_URL=postgresql://cn_terminal_user:YOUR_DB_PASSWORD@postgres:5432/cn_terminal_db?schema=public

# ============================================
# Server Configuration
# ============================================
# Backend server port (default: 5000)
PORT=5000

# ============================================
# JWT Authentication
# ============================================
# Secret key for JWT token signing (use a strong, random string)
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE

# ============================================
# Frontend/Backend URLs
# ============================================
# Frontend application URL (for CORS and Socket.IO)
# Example: https://yourdomain.com or https://app.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Production API URL
# Example: https://api.yourdomain.com or https://yourdomain.com/api
PRODUCTION_URL=https://api.yourdomain.com

# Application base URL (used for invitation links and email templates)
# Example: https://yourdomain.com
APP_BASE_URL=https://yourdomain.com

# CORS allowed origins (comma-separated for multiple origins)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# ============================================
# Email Configuration (SendGrid)
# ============================================
# SendGrid API Key (get from SendGrid dashboard)
# https://app.sendgrid.com/settings/api_keys
REACT_APP_SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE

# Email sender address
# For production, use a verified domain or SendGrid subdomain
# Example: noreply@yourdomain.com or noreply@sendgrid.net
REACT_APP_FROM_EMAIL=noreply@yourdomain.com

# Email sender name
REACT_APP_FROM_NAME=CN Terminal

# Email development mode (set to false for production to send real emails)
REACT_APP_EMAIL_DEV_MODE=false

# ============================================
# Frontend Build Configuration
# ============================================
# Backend API URL for frontend (used during build)
# This should match your production backend URL
# Example: https://api.yourdomain.com/api
REACT_APP_API_URL=https://api.yourdomain.com/api

# ============================================
# Docker Configuration (if using docker-compose)
# ============================================
# Database password for Docker PostgreSQL container
DB_PASSWORD=YOUR_DB_PASSWORD

# ============================================
# Notes:
# ============================================
# 1. Replace all placeholder values (YOUR_*) with actual production values
# 2. Ensure JWT_SECRET is a strong, random string (at least 32 characters)
# 3. Verify your SendGrid API key has proper permissions
# 4. Verify your email sender domain in SendGrid
# 5. Update all URLs to match your production domain
# 6. Keep .env.production file secure and never commit it to version control
# 7. For docker-compose deployments, use the same values in docker-compose.prod.yml

